{
  "name": "promptmeter",
  "version": "0.1.0",
  "description": "Terminal-native LLM cost & model-intelligence layer for Claude Code",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "bin": {
    "promptmeter": "bin/promptmeter.js"
  },
  "files": [
    "dist",
    "bin",
    "data"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepare": "npm run build",
    "start": "node bin/promptmeter.js",
    "wire": "node bin/promptmeter.js install",
    "unwire": "node bin/promptmeter.js uninstall",
    "wire:status": "node bin/promptmeter.js status",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12",
    "ignore": "^7.0.5",
    "ink": "^5.2.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18.3.31",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3",
    "tsup": "^8",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4.1.9"
  }
}
